  Component(model, "SessionTransformer", "simulation/generator/session_transformer.py", "Causal decoder with cross-session memory and action/category/item/temporal heads")
  Component(objective, "Training Objective and Optimizer", "PyTorch", "Factored cross-entropy losses, optional popularity mitigation, AdamW, scheduler, autocast, grad clipping")
  Component(selector, "Checkpoint Selector", "train.py", "Chooses best model by validation loss and applies early stopping")
}

Rel(clean_store, interaction_loader, "Train and validation sessions")
Rel(cache_store, interaction_loader, "Session caches and vocab")
