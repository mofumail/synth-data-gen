@startuml
title <size:24>Dynamic View: Session Generator Pipeline - Training</size>\n<size:24>Code flow (train.py): one training step plus periodic checkpoint selection.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("SessionGeneratorPipeline_boundary", "Session Generator Pipeline", $tags="") {
  Container_Boundary("SessionGeneratorPipeline.Training_boundary", "Training", $tags="") {
    Component(SessionGeneratorPipeline.Training.Trainingloop, "Training loop", $techn="", $descr="train.py: epoch loop, AdamW + cosine schedule, bf16 autocast, grad clip, early stopping, checkpoint to model.pt/model.yaml.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.Interactionloader, "Interaction loader", $techn="", $descr="InteractionGenerator: streams (events, items, deltas, categories, mask, lengths, history) batches for train/val splits.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.Multiheadloss, "Multi-head loss", $techn="", $descr="Factored CE over action / category / item / temporal heads + inverse-frequency item weighting + category logit adjustment.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.SessionTransformer, "SessionTransformer", $techn="", $descr="The model under training: input embedding, causal backbone, four factored heads.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.IntrainingTSTRprobe, "In-training TSTR probe", $techn="", $descr="evaluation/in_train_tstr.py: every N epochs generate synth, fit GRU4Rec, score HR@K to select the best checkpoint.", $tags="", $link="")
  }

  ContainerDb(SessionGeneratorPipeline.Modelcheckpoints, "Model checkpoints", $techn="joblib / pt", $descr="model.pt + model.yaml (best by val-loss or TSTR HR@K).", $tags="", $link="")
}

ContainerDb(SessionGeneratorPipeline.Modelcheckpoints, "Model checkpoints", $techn="joblib / pt", $descr="model.pt + model.yaml (best by val-loss or TSTR HR@K).", $tags="", $link="")

Rel(SessionGeneratorPipeline.Training.Interactionloader, SessionGeneratorPipeline.Training.Trainingloop, "1: next batch", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Trainingloop, SessionGeneratorPipeline.Training.SessionTransformer, "2: forward (teacher forcing)", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.SessionTransformer, SessionGeneratorPipeline.Training.Multiheadloss, "3: four-head logits", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Multiheadloss, SessionGeneratorPipeline.Training.Trainingloop, "4: total loss -> backward + step", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Trainingloop, SessionGeneratorPipeline.Training.IntrainingTSTRprobe, "5: every N epochs: candidate", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.IntrainingTSTRprobe, SessionGeneratorPipeline.Training.Trainingloop, "6: HR@K signal", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Trainingloop, SessionGeneratorPipeline.Modelcheckpoints, "7: promote best checkpoint", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml