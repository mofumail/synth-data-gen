@startuml
title <size:24>Component View: Session Generator Pipeline - Training</size>\n<size:24>Level 3: the interaction loader feeds the training loop, which trains the SessionTransformer under the four-head loss and selects checkpoints via the TSTR probe.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("SessionGeneratorPipeline_boundary", "Session Generator Pipeline", $tags="") {
  Container_Boundary("SessionGeneratorPipeline.Training_boundary", "Training", $tags="") {
    Component(SessionGeneratorPipeline.Training.Trainingloop, "Training loop", $techn="", $descr="train.py: epoch loop, AdamW + cosine schedule, bf16 autocast, grad clip, early stopping, checkpoint to model.pt/model.yaml.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.Interactionloader, "Interaction loader", $techn="", $descr="InteractionGenerator: streams (events, items, deltas, categories, mask, lengths, history) batches for train/val splits.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.Multiheadloss, "Multi-head loss", $techn="", $descr="Factored CE over action / category / item / temporal heads + inverse-frequency item weighting + category logit adjustment.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.SessionTransformer, "SessionTransformer", $techn="", $descr="The model under training: input embedding, causal backbone, four factored heads.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Training.IntrainingTSTRprobe, "In-training TSTR probe", $techn="", $descr="evaluation/in_train_tstr.py: every N epochs generate synth, fit GRU4Rec, score HR@K to select the best checkpoint.", $tags="", $link="")
  }

  ContainerDb(SessionGeneratorPipeline.Cleaneventstore, "Clean event store", $techn="Parquet", $descr="events_clean.parquet (train+val), events_test.parquet.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Vocabcodebook, "Vocab & codebook", $techn="joblib", $descr="sku2idx, cat2idx, SKU price/name tables, SVD-PQ tokens.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Modelcheckpoints, "Model checkpoints", $techn="joblib / pt", $descr="model.pt + model.yaml (best by val-loss or TSTR HR@K).", $tags="", $link="")
}

Rel(SessionGeneratorPipeline.Cleaneventstore, SessionGeneratorPipeline.Training.Interactionloader, "train / val splits", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Vocabcodebook, SessionGeneratorPipeline.Training.Interactionloader, "vocab + tokens", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Interactionloader, SessionGeneratorPipeline.Training.Trainingloop, "batches", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Trainingloop, SessionGeneratorPipeline.Training.SessionTransformer, "forward (teacher forcing)", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.SessionTransformer, SessionGeneratorPipeline.Training.Multiheadloss, "four-head logits", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Multiheadloss, SessionGeneratorPipeline.Training.Trainingloop, "total loss", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Trainingloop, SessionGeneratorPipeline.Training.IntrainingTSTRprobe, "candidate checkpoint", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.IntrainingTSTRprobe, SessionGeneratorPipeline.Training.Trainingloop, "HR@K signal", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training.Trainingloop, SessionGeneratorPipeline.Modelcheckpoints, "best checkpoint", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml