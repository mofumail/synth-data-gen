@startuml
title <size:24>Component View: Session Generator Pipeline - Simulation runtime</size>\n<size:24>Level 3: arrival + identity models seed the orchestrator; the session generator runs the backbone and four factored heads; the validity layer gates the output log.</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("SessionGeneratorPipeline_boundary", "Session Generator Pipeline", $tags="") {
  Container_Boundary("SessionGeneratorPipeline.Simulationruntime_boundary", "Simulation runtime", $tags="") {
    Component(SessionGeneratorPipeline.Simulationruntime.Simulationorchestrator, "Simulation orchestrator", $techn="", $descr="simulation/orchestrator.py: time-stepped loop, multiprocessing pool, per-user history buffer, chunked parquet writer.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.MMPParrivalmodel, "MMPP arrival model", $techn="", $descr="simulation/arrival/mmpp.py: Markov-modulated Poisson process inter-arrival delays.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Timeofdayarrival, "Time-of-day arrival", $techn="", $descr="simulation/arrival/tod.py: diurnal inter-arrival delays (alternative model).", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Identitysampler, "Identity sampler", $techn="", $descr="simulation/identity/sampler.py: SimpleIdentitySampler emits frequency-weighted (client_id, sku) seed pairs.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.CTGANidentityfactory, "CTGAN identity factory", $techn="", $descr="simulation/identity/CTGAN.py: IdentityFactory learns the joint (client_id, sku) distribution (alternative).", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Sessiongenerator, "Session generator", $techn="", $descr="simulation/generator/session_generator.py: inference wrapper, lazy model load, batch autoregressive generation, validity post-filter.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Crosssessionhistory, "Cross-session history", $techn="", $descr="simulation/generator/cross_session_history.py: attention-pools up to H past events into a memory vector.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Inputembedding, "Input embedding", $techn="", $descr="Sums action, item, dt, position, category, price and quantized-name embeddings.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, "Transformer backbone", $techn="", $descr="Causal decoder over the session prefix with cross-attention to the history memory.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Actionhead, "Action head", $techn="", $descr="Softmax over 5 actions + EOS.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Categoryhead, "Category head", $techn="", $descr="Categorical over product categories at item-bearing positions.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Itemhead, "Item head", $techn="", $descr="Per iteration: flat / hierarchical / SVD-PQ item prediction (sec. 6.3).", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Temporalhead, "Temporal head", $techn="", $descr="Categorical over log-spaced dt bins.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Validitylayer, "Validity layer", $techn="", $descr="simulation/validity.py: illegal transitions, dt monotonicity, prior-exposure checks.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Simulationruntime.Outputlogwriter, "Output log writer", $techn="", $descr="Serializes validated sessions to synthetic parquet in chunks.", $tags="", $link="")
  }

  ContainerDb(SessionGeneratorPipeline.Modelcheckpoints, "Model checkpoints", $techn="joblib / pt", $descr="model.pt + model.yaml (best by val-loss or TSTR HR@K).", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Syntheticlogstore, "Synthetic log store", $techn="Parquet", $descr="Generated session parquet shards.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Referencestore, "Reference store", $techn="joblib", $descr="reference_store_v{K}.joblib (train + val profiles).", $tags="", $link="")
}

Rel(SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, SessionGeneratorPipeline.Simulationruntime.Temporalhead, "hidden state h_t", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Actionhead, SessionGeneratorPipeline.Simulationruntime.Categoryhead, "cond. action", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Categoryhead, SessionGeneratorPipeline.Simulationruntime.Itemhead, "cond. category", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Actionhead, SessionGeneratorPipeline.Simulationruntime.Itemhead, "cond. action", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Itemhead, SessionGeneratorPipeline.Simulationruntime.Temporalhead, "cond. item", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Actionhead, SessionGeneratorPipeline.Simulationruntime.Validitylayer, "predicted action", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Itemhead, SessionGeneratorPipeline.Simulationruntime.Validitylayer, "predicted item", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Temporalhead, SessionGeneratorPipeline.Simulationruntime.Validitylayer, "predicted dt", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Validitylayer, SessionGeneratorPipeline.Simulationruntime.Outputlogwriter, "validated event", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Referencestore, SessionGeneratorPipeline.Simulationruntime.Validitylayer, "legal bigrams", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Outputlogwriter, SessionGeneratorPipeline.Syntheticlogstore, "session shards", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.MMPParrivalmodel, SessionGeneratorPipeline.Simulationruntime.Simulationorchestrator, "inter-arrival delay", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Timeofdayarrival, SessionGeneratorPipeline.Simulationruntime.Simulationorchestrator, "inter-arrival delay", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Identitysampler, SessionGeneratorPipeline.Simulationruntime.Simulationorchestrator, "(client_id, sku) seed", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.CTGANidentityfactory, SessionGeneratorPipeline.Simulationruntime.Simulationorchestrator, "(client_id, sku) seed", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Simulationorchestrator, SessionGeneratorPipeline.Simulationruntime.Sessiongenerator, "seed + user history", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Modelcheckpoints, SessionGeneratorPipeline.Simulationruntime.Sessiongenerator, "model checkpoint", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Sessiongenerator, SessionGeneratorPipeline.Simulationruntime.Crosssessionhistory, "past events", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Crosssessionhistory, SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, "history memory", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Sessiongenerator, SessionGeneratorPipeline.Simulationruntime.Inputembedding, "session prefix", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Inputembedding, SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, "embedded prefix", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, SessionGeneratorPipeline.Simulationruntime.Actionhead, "hidden state h_t", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, SessionGeneratorPipeline.Simulationruntime.Categoryhead, "hidden state h_t", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime.Transformerbackbone, SessionGeneratorPipeline.Simulationruntime.Itemhead, "hidden state h_t", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml