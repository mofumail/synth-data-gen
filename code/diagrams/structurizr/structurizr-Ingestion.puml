@startuml
title <size:24>Component View: Session Generator Pipeline - Ingestion</size>\n<size:24>Level 3: preprocessing, dataset/vocab construction, SVD-PQ tokenization, and the optional Mongo ingestor.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(RawSyneriseeventstream, "Raw Synerise event stream", $descr="168 days of e-commerce interaction logs + product properties.", $tags="", $link="")
System(MongoDB, "MongoDB", $descr="Optional document store fed by the ingestor (per event-type collections).", $tags="", $link="")

System_Boundary("SessionGeneratorPipeline_boundary", "Session Generator Pipeline", $tags="") {
  Container_Boundary("SessionGeneratorPipeline.Ingestion_boundary", "Ingestion", $tags="") {
    Component(SessionGeneratorPipeline.Ingestion.Mongoingestor, "Mongo ingestor", $techn="", $descr="ingestion/ingestor.py: optional bulk insert of cleaned events into MongoDB collections.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Ingestion.Preprocess, "Preprocess", $techn="", $descr="preprocess.py: merge 6 parquets, dedup, sessionize (30-min gap), join product properties, train/val/test split, build cat2idx.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Ingestion.Datasetbuilder, "Dataset builder", $techn="", $descr="ingestion/dataset.py: SessionDataset / InteractionGenerator, top-K sku2idx vocab, SKU price+name property tables, cached .npy splits.", $tags="", $link="")
    Component(SessionGeneratorPipeline.Ingestion.SVDPQtokenizer, "SVD-PQ tokenizer", $techn="", $descr="ingestion/svdpq.py: weighted user-item matrix, BM25 damping, truncated SVD, per-dim quantization, cold-start category-centroid fallback.", $tags="", $link="")
  }

  ContainerDb(SessionGeneratorPipeline.Cleaneventstore, "Clean event store", $techn="Parquet", $descr="events_clean.parquet (train+val), events_test.parquet.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Vocabcodebook, "Vocab & codebook", $techn="joblib", $descr="sku2idx, cat2idx, SKU price/name tables, SVD-PQ tokens.", $tags="", $link="")
}

Rel(RawSyneriseeventstream, SessionGeneratorPipeline.Ingestion.Preprocess, "raw events", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.Preprocess, SessionGeneratorPipeline.Cleaneventstore, "events_clean / events_test", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.Preprocess, SessionGeneratorPipeline.Ingestion.Datasetbuilder, "sessionized events", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.Datasetbuilder, SessionGeneratorPipeline.Ingestion.SVDPQtokenizer, "item interactions", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.Datasetbuilder, SessionGeneratorPipeline.Vocabcodebook, "sku2idx, properties", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.SVDPQtokenizer, SessionGeneratorPipeline.Vocabcodebook, "SVD-PQ tokens", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.Preprocess, SessionGeneratorPipeline.Ingestion.Mongoingestor, "cleaned events", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion.Mongoingestor, MongoDB, "collections", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml