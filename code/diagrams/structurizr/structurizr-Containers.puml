@startuml
title <size:24>Container View: Session Generator Pipeline</size>\n<size:24>Level 2: ingestion -> training -> simulation -> evaluation, communicating through durable on-disk artefact stores (cylinders).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Researcher, "Researcher", $descr="Configures the pipeline, runs it, and inspects the metrics.", $tags="", $link="")
System(RawSyneriseeventstream, "Raw Synerise event stream", $descr="168 days of e-commerce interaction logs + product properties.", $tags="", $link="")
System(Realheldoutsplit, "Real held-out split", $descr="Sibling input to evaluation; cleaned but not used in training.", $tags="", $link="")
System(MongoDB, "MongoDB", $descr="Optional document store fed by the ingestor (per event-type collections).", $tags="", $link="")

System_Boundary("SessionGeneratorPipeline_boundary", "Session Generator Pipeline", $tags="") {
  Container(SessionGeneratorPipeline.Training, "Training", $techn="PyTorch", $descr="Teacher-forced multi-head training of the transformer generator.", $tags="", $link="")
  Container(SessionGeneratorPipeline.Simulationruntime, "Simulation runtime", $techn="PyTorch / multiprocessing", $descr="Arrivals + identities drive autoregressive sampling, gated by a hard-constraint validity layer.", $tags="", $link="")
  Container(SessionGeneratorPipeline.Evaluation, "Evaluation", $techn="Python", $descr="Fidelity, validity, and TSTR-utility metrics over multiple seeds.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Cleaneventstore, "Clean event store", $techn="Parquet", $descr="events_clean.parquet (train+val), events_test.parquet.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Vocabcodebook, "Vocab & codebook", $techn="joblib", $descr="sku2idx, cat2idx, SKU price/name tables, SVD-PQ tokens.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Modelcheckpoints, "Model checkpoints", $techn="joblib / pt", $descr="model.pt + model.yaml (best by val-loss or TSTR HR@K).", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Syntheticlogstore, "Synthetic log store", $techn="Parquet", $descr="Generated session parquet shards.", $tags="", $link="")
  ContainerDb(SessionGeneratorPipeline.Referencestore, "Reference store", $techn="joblib", $descr="reference_store_v{K}.joblib (train + val profiles).", $tags="", $link="")
  Container(SessionGeneratorPipeline.Ingestion, "Ingestion", $techn="Python / Polars", $descr="Cleaning, time-aware split, top-K vocab, SVD-PQ codebook construction.", $tags="", $link="")
}

Rel(RawSyneriseeventstream, SessionGeneratorPipeline.Ingestion, "raw events + product properties", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion, SessionGeneratorPipeline.Cleaneventstore, "cleaned, sessionized parquets", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion, SessionGeneratorPipeline.Vocabcodebook, "top-K vocab + SVD-PQ codebook", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Ingestion, MongoDB, "optional bulk insert", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Cleaneventstore, SessionGeneratorPipeline.Training, "train / val splits", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Vocabcodebook, SessionGeneratorPipeline.Training, "vocab, properties, tokens", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Training, SessionGeneratorPipeline.Modelcheckpoints, "best checkpoint", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Modelcheckpoints, SessionGeneratorPipeline.Simulationruntime, "model checkpoint", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Vocabcodebook, SessionGeneratorPipeline.Simulationruntime, "vocab + tokens", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Simulationruntime, SessionGeneratorPipeline.Syntheticlogstore, "validated session log", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Cleaneventstore, SessionGeneratorPipeline.Evaluation, "real reference splits", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Evaluation, SessionGeneratorPipeline.Referencestore, "reference profiles", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Evaluation, SessionGeneratorPipeline.Simulationruntime, "generate synthetic sessions", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Referencestore, SessionGeneratorPipeline.Simulationruntime, "legal bigrams (validity)", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Modelcheckpoints, SessionGeneratorPipeline.Evaluation, "model under test", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Syntheticlogstore, SessionGeneratorPipeline.Evaluation, "synthetic session log", $techn="", $tags="", $link="")
Rel(Realheldoutsplit, SessionGeneratorPipeline.Evaluation, "real held-out split", $techn="", $tags="", $link="")
Rel(SessionGeneratorPipeline.Evaluation, Researcher, "fidelity / validity / TSTR metrics", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml